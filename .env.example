# SUSKII central admin — environment variables.
# Copy to .env for local development. NEVER commit real values; in production set them in
# Vercel → Project → Settings → Environment Variables (encrypted, server-side only).

# ─── Core ───────────────────────────────────────────────────────────────────
# development | preview | production (defaults from VERCEL_ENV / NODE_ENV)
APP_ENV=development
# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, RDS…). Use sslmode=require in production.
# Local development defaults to an embedded database: pglite:./.data/pglite
DATABASE_URL=
# 32+ random characters. Encrypts stored credentials and MFA secrets. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CENTRAL_ADMIN_SECRET=
# Public address of this site (used in reset links, webhooks and canonical URLs)
SITE_ORIGIN=https://suskii-website.vercel.app

# ─── First administrator (optional browser setup) ───────────────────────────
# 24+ random characters. Enables /admin/setup ONLY while no administrator exists. Remove after use.
# Prefer: ADMIN_EMAIL=you@suskii.com ADMIN_NAME="Your Name" npm run admin:create
ADMIN_BOOTSTRAP_TOKEN=

# ─── Publishing, jobs, storage, email ───────────────────────────────────────
# Vercel deploy hook: rebuilds the static site when content is published
VERCEL_DEPLOY_HOOK_URL=
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to /api/cron
CRON_SECRET=
# Vercel Blob token for media uploads and CVs (required in production for uploads)
BLOB_READ_WRITE_TOKEN=
# Resend (https://resend.com) for invitations and password resets. Without it, Super Admins see one-time links instead.
RESEND_API_KEY=
MAIL_FROM="SUSKII Admin <admin@suskii.com>"

# ─── Platform integrations (each optional and independent) ─────────────────
# Environment values take precedence over values saved in Admin → Integrations.
SUSKII_MARKETPLACE_API_URL=
SUSKII_MARKETPLACE_API_KEY=
WEBHOOK_MARKETPLACE_SECRET=
SUSKII_ERRANDS_API_URL=
SUSKII_ERRANDS_API_KEY=
WEBHOOK_ERRANDS_SECRET=
SUSKII_TRAVEL_API_URL=
SUSKII_TRAVEL_API_KEY=
WEBHOOK_TRAVEL_SECRET=

# Demo mode shows clearly labelled synthetic data. It is always available outside production;
# in production it stays OFF unless this is explicitly true (only for a labelled demo environment).
ALLOW_DEMO_MODE_IN_PRODUCTION=false

# ─── Break-glass admin password recovery (Production only; remove after one deploy) ───
# Generate the hash with: ADMIN_EMAIL=… npm run admin:hash-password
ADMIN_RECOVERY_EMAIL=
ADMIN_RECOVERY_PASSWORD_HASH=
ADMIN_RECOVERY_RESET_MFA=false
